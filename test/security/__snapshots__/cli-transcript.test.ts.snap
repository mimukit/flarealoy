    "err": "",
    "out": "example.com: drift
  http_request_firewall_custom: missing flarewall_ports "flarewall: block non-standard ports"
  http_request_firewall_custom: missing flarewall_probes "flarewall: block scanner probes"
  http_request_firewall_custom: missing flarewall_hosting "flarewall: challenge hosting networks (verified bots, API hosts, origins allowed)"
  http_ratelimit: missing flarewall_rate_limit "flarewall: rate limit per IP and data center"
  http_request_dynamic_redirect: missing flarewall_https "flarewall: redirect HTTP to HTTPS"
  http_request_dynamic_redirect: missing flarewall_canonical_host "flarewall: redirect to the canonical host"
  setting always_use_https: live "off"; want "on"
  setting browser_check: live "off"; want "on"
  bot management: live {"fight_mode":false,"enable_js":false}; want {"fight_mode":true,"enable_js":true}
example.net: in sync",
  },
  "runs": 2,
}
`;

